{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Clipper Studio",
  "version": "0.1.0",
  "identifier": "id.personalclipper.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Personal Clipper Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:8765 http://localhost:8765; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Local-first video clipping workspace",
    "category": "Video",
    "resources": [
      "resources/pcs-api/"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
